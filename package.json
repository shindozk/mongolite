{
  "name": "@shindozk/mongolite",
  "version": "1.0.0",
  "description": "Lightweight, embedded local database engine for MongoDB built with TypeScript and Bun.js. Zero-dependency, MongoDB-compatible API.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=./dist --target=bun",
    "test": "bun test",
    "start": "bun src/index.ts",
    "prepublishOnly": "bun run build && bun test"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.0",
    "biome": "^1.9.0"
  },
  "bin": {
    "mongolite": "./dist/cli/app.js"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "mongo",
    "lite",
    "local",
    "database",
    "embedded",
    "typescript",
    "bun",
    "nosql",
    "document-store",
    "sqlite-alternative",
    "mongodb-compatible"
  ],
  "author": "shindozk",
  "repository": {
    "type": "git",
    "url": "https://github.com/shindozk/mongolite.git"
  },
  "bugs": {
    "url": "https://github.com/shindozk/mongolite/issues"
  },
  "homepage": "https://github.com/shindozk/mongolite#readme",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/shindozk"
  }
}